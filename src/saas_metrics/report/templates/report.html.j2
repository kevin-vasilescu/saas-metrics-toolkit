<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root{--fg:#111827;--muted:#6b7280;--line:#e5e7eb;--bg:#f9fafb;--accent:#4f46e5}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
main{max-width:1100px;margin:0 auto;padding:32px 20px 64px}
h1{margin:0 0 4px;font-size:28px}
h2{margin:40px 0 12px;font-size:19px}
.sub{color:var(--muted);margin:0}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-top:24px}
.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.card .label{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.04em}
.card .value{font-size:24px;font-weight:650;margin-top:2px}
.card .change{color:var(--muted);font-size:12px}
.panel{background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px}
.scroll{overflow-x:auto;background:#fff;border:1px solid var(--line);border-radius:10px}
table{border-collapse:collapse;width:100%;font-size:13px;white-space:nowrap}
th,td{padding:7px 10px;text-align:right;border-bottom:1px solid var(--line)}
th{background:#f3f4f6;position:sticky;top:0;font-weight:600}
th:first-child,td:first-child{text-align:left;position:sticky;left:0;background:inherit}
tbody tr:nth-child(even){background:#fafafa}
.heat td{text-align:center;border-bottom:0;border-right:1px solid #fff}
.heat td:first-child{text-align:left}
footer{margin-top:40px;color:var(--muted);font-size:12px}
@media (max-width:600px){h1{font-size:22px}.card .value{font-size:20px}}
</style>
</head>
<body>
<main>
<h1>{{ title }}</h1>
<p class="sub">{{ first }} to {{ last }} ({{ months }} months) &middot; gross margin {{ margin }}</p>
<section class="cards">
{% for c in cards %}<div class="card"><div class="label">{{ c.label }}</div><div class="value">{{ c.value }}</div><div class="change">vs previous: {{ c.change }}</div></div>
{% endfor %}</section>
<h2>MRR</h2>
<div class="panel">{{ chart }}</div>
<h2>Monthly metrics</h2>
<div class="scroll"><table>
<thead><tr>{% for h in headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>
{% endfor %}</tbody>
</table></div>
<h2>Cohort retention</h2>
<div class="scroll"><table class="heat">
<thead><tr><th>Cohort</th><th>Customers</th>{% for h in cohort_headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in cohort_rows %}<tr><td>{{ r.cohort }}</td><td>{{ r.size }}</td>{% for c in r.cells %}<td style="{{ c.style }}">{{ c.text }}</td>{% endfor %}</tr>
{% endfor %}</tbody>
</table></div>
<footer>Generated by saas-metrics-toolkit. Values shown as n/a are undefined for that month.</footer>
</main>
</body>
</html>
